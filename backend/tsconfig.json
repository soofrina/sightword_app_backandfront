{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": false,
    "module": "commonjs",
    "noFallthroughCasesInSwitch": false,
    "outDir": "./dist",
    "paths": {
      "*": [
        "./src/*"
      ]
    },
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictBindCallApply": false,
    "target": "es2017",
    "types": [
      "node",
      "jest"
    ]
  }
}